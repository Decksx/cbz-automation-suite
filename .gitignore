# ── Logs ──────────────────────────────────────────────
# Log files are machine-specific runtime output — never committed.
# The Logs/ folder itself is committed (via Logs/.gitkeep) so it
# always exists on a fresh clone without needing os.makedirs.
Logs/*.log
Logs/*.log.1
Logs/*.log.2
Logs/*.log.3
Logs/cbz_gaps_*.csv
# Keep the folder anchor
!Logs/.gitkeep

# ── Temp files created by the watcher ─────────────────
*.tmp.cbz
*.bak.cbz

# ── Python ────────────────────────────────────────────
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python
*.egg-info/
dist/
build/
*.egg

# ── Virtual environments ───────────────────────────────
.venv/
venv/
env/
.env

# ── OS / editor cruft ─────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini
*.swp
*.swo
.idea/
.vscode/
*.sublime-project
*.sublime-workspace

# ── CBZ files (don't accidentally commit comics) ───────
*.cbz
*.cbr
*.cb7

# ── Runtime state — lives at C:\\git\\ComicAutomation\ ───────
# Progress tracking files (auto-generated, machine-specific)
*_progress.json
# Live routing config (copy config\routing.example.json and edit)
routing.json
