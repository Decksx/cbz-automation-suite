{
  "id": "maintenance",
  "label": "Library Maintenance",
  "description": "Run sanitization, archive cleanup, series organization, metadata repair, and name repair as one configurable workflow.",
  "domain": "workflows",
  "module": "scripts.cbz_workflows",
  "subcommand": "maintenance",
  "parser": "scripts.cbz_workflows:build_parser",
  "kind": "task",
  "effects": "writes_files",
  "dry_run": {"param": "dry_run", "default": true},
  "stop": {
    "mode": "none",
    "read_only_runs": "terminate_job",
    "gate": "M4-maintenance-interrupt",
    "reason": "Stopping a writing run is enabled after the interrupt/recovery gate (design 5.5)"
  },
  "params": [
    {"key": "root", "type": "path", "role": "library", "kind": "dir", "must_exist": true,
     "label": "Library folder", "emit": {"style": "positional"}},
    {"key": "dry_run", "type": "bool", "default": true, "label": "Dry run",
     "emit": {"style": "flag", "flag": "--dry-run"}},
    {"key": "stages", "type": "multi_choice", "ordered": false, "min": 1,
     "choices": ["sanitize", "archive", "organize", "metadata", "names"],
     "default": ["sanitize", "archive", "organize", "metadata", "names"],
     "label": "Maintenance stages", "emit": {"style": "csv", "flag": "--stages"}},
    {"key": "sort", "type": "choice", "group": "sanitizer",
     "choices": ["newest", "oldest", "alpha", "alpha-reverse"], "default": "newest",
     "label": "Sanitizer sort order", "emit": {"style": "equals", "flag": "--sort"}},
    {"key": "full_rescan", "type": "bool", "default": false, "group": "sanitizer",
     "label": "Sanitizer full rescan", "emit": {"style": "flag", "flag": "--full"}},
    {"key": "restart", "type": "bool", "default": false, "group": "sanitizer",
     "label": "Clear sanitizer progress before running", "emit": {"style": "flag", "flag": "--restart"}},
    {"key": "rules", "type": "multi_choice", "default": [], "group": "sanitizer",
     "choices": ["brackets", "comicinfo", "leading_nums", "non_latin", "normalize_stem",
                 "number_tokens", "scan_groups", "trailing_junk", "translate", "url"],
     "label": "Sanitizer rules", "help": "Leave all unchecked to use every sanitizer rule.",
     "emit": {"style": "csv", "flag": "--rules", "omit_empty": true}},
    {"key": "metadata_dedupe", "type": "bool", "default": true,
     "label": "Match duplicates by ComicInfo metadata",
     "emit": {"style": "flag_false", "flag": "--no-metadata-dedupe"}},
    {"key": "names_only", "type": "bool", "default": false,
     "label": "Name repair: skip ComicInfo metadata", "emit": {"style": "flag", "flag": "--names-only"}},
    {"key": "workers", "type": "choice", "choices": ["1", "2", "4", "8", "12", "20"],
     "default": "8", "label": "Workers", "emit": {"style": "option", "flag": "--workers"}}
  ]
}
